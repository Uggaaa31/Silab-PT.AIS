# ==============================================================================
# LABMINERAL - DOCKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE TUNNEL CONFIGURATION
# ------------------------------------------------------------------------------
# Cara termudah & paling direkomendasikan:
# Buka Cloudflare Zero Trust Dashboard (https://one.dash.cloudflare.com)
# Masuk ke Networks > Tunnels > Create a Tunnel > Pilih Cloudflared.
# Berikan nama tunnel, lalu pada step connector pilih "Docker".
# Cloudflare akan memberikan command seperti:
#   docker run cloudflare/cloudflared:latest tunnel --no-autoupdate run --token eyJh...
# Salin token panjang setelah parameter --token dan tempelkan di bawah ini:
CLOUDFLARE_TUNNEL_TOKEN=eyJhX0YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE

# (Opsional) Jika Anda mencatat Tunnel ID untuk referensi:
CLOUDFLARE_TUNNEL_ID=your-tunnel-id-uuid-here

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MariaDB / MySQL)
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=labmineral
DB_USER=labuser
DB_PASS=labmineral_secure_pass2026
DB_ROOT_PASSWORD=root_secure_pass2026

# ------------------------------------------------------------------------------
# 3. WEB APP & PORTS CONFIGURATION
# ------------------------------------------------------------------------------
# Port akses lokal di Ubuntu Server (LAN / Proxmox VM):
# http://<IP_UBUNTU_SERVER>:8080
APP_PORT=8080

# Port phpMyAdmin untuk kelola database lewat browser:
# http://<IP_UBUNTU_SERVER>:8081
PMA_PORT=8081

# Nama Aplikasi
APP_NAME="LabMineral Pro"

# Base URL (Kosongkan jika diakses di root domain, misal: https://lab.domainanda.com)
# Jika diakses lewat subpath lokal (misal: /labmineral), isi dengan /labmineral
BASE_URL=

# Secret API Key untuk autentikasi data sync dari Android XRF Explorer 7000
XRF_SECRET_KEY=xrf_secret_labmineral_2026

